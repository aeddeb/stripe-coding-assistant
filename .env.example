# Copy to .env and fill in. .env is gitignored — never commit real keys.
# In deployment these live as platform secrets (HF Space / scheduled runner), never in git.

# Stripe TEST-MODE key only (dashboard.stripe.com → Test mode → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# LLM generation. Providers are tried in order — Gemini, Groq, OpenAI — and
# any provider without a key is skipped, so set only the ones you want used.
# Primary: Gemini Flash — free tier, key from aistudio.google.com
GEMINI_API_KEY=...
# Fallback on 429: Groq — free tier, key from console.groq.com
GROQ_API_KEY=...
# Paid alternative (used when it's the only key set) — platform.openai.com
# OPENAI_API_KEY=...

# Postgres — local docker-compose defaults (dev + grader path)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stripe_assistant
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Cloud Postgres (Neon) — deployed app + scheduled ingest use this instead of the above
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# Grafana (local docker-compose only). Defaults work out of the box:
# admin login admin/admin for editing, anonymous viewers read-only, and the
# dashboards query Postgres as `grafana_ro` (SELECT-only role).
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_DB_PASSWORD=grafana
