# Copy to .env and fill in. .env is gitignored — never commit real keys.
# In deployment these live as platform secrets (HF Space / scheduled runner), never in git.

# Stripe TEST-MODE key only (dashboard.stripe.com → Test mode → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# LLM generation — free tiers, no card on file (the rate limit IS the budget cap)
# Primary: Gemini Flash — key from aistudio.google.com
GEMINI_API_KEY=...
# Fallback on 429: Groq — key from console.groq.com (OpenAI-compatible, base_url swap)
GROQ_API_KEY=...

# Postgres — local docker-compose defaults (dev + grader path)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stripe_assistant
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Cloud Postgres (Neon) — deployed app + scheduled ingest use this instead of the above
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
